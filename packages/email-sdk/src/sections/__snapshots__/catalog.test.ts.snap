                            </table>
                            <table
                              align="center"
                              width="100%"
                              border="0"
                              cellpadding="0"
                              cellspacing="0"
                              role="presentation">
                              <tbody style="width:100%">
                                <tr style="width:100%">
                                  <td
                                    data-id="__react-email-column"
                                    style="padding-top:0px;padding-bottom:24px;padding-left:0px;padding-right:0px">
                                    <pre
                                      style='background:hsl(220, 13%, 18%);color:hsl(220, 14%, 71%);text-shadow:0 1px rgba(0, 0, 0, 0.3);font-family:"Fira Code", "Fira Mono", Menlo, Consolas, "DejaVu Sans Mono", monospace;direction:ltr;text-align:left;white-space:pre;word-spacing:normal;word-break:normal;line-height:1.5;-moz-tab-size:2;-o-tab-size:2;tab-size:2;-webkit-hyphens:none;-moz-hyphens:none;hyphens:none;padding:1em;margin:0;overflow:auto;border-radius:0.3em;width:100%'><code><span style="color:hsl(286, 60%, 67%)">import</span><span> ‍​</span><span style="color:hsl(220, 14%, 71%)">{</span><span> ‍​send ‍​</span><span style="color:hsl(220, 14%, 71%)">}</span><span> ‍​</span><span style="color:hsl(286, 60%, 67%)">from</span><span> ‍​</span><span style="color:hsl(95, 38%, 62%)">&quot;@acme/sdk&quot;</span><span style="color:hsl(220, 14%, 71%)">;</span><br/><span></span><br/><span style="color:hsl(286, 60%, 67%)">await</span><span> ‍​</span><span style="color:hsl(207, 82%, 66%)">send</span><span style="color:hsl(220, 14%, 71%)">(</span><span style="color:hsl(220, 14%, 71%)">{</span><br/><span> ‍​ ‍​to</span><span style="color:hsl(207, 82%, 66%)">:</span><span> ‍​</span><span style="color:hsl(95, 38%, 62%)">&quot;ada@example.com&quot;</span><span style="color:hsl(220, 14%, 71%)">,</span><br/><span> ‍​ ‍​subject</span><span style="color:hsl(207, 82%, 66%)">:</span><span> ‍​</span><span style="color:hsl(95, 38%, 62%)">&quot;Hello from Acme&quot;</span><span style="color:hsl(220, 14%, 71%)">,</span><br/><span style="color:hsl(220, 14%, 71%)">}</span><span style="color:hsl(220, 14%, 71%)">)</span><span style="color:hsl(220, 14%, 71%)">;</span><br/></code></pre>
                                  </td>
                                </tr>
                              </tbody>
                            </table>
                            <table
                              align="center"
                              width="100%"
                              border="0"
                              cellpadding="0"
                              cellspacing="0"
                              role="presentation">
                              <tbody style="width:100%">
                                <tr style="width:100%">
                                  <td
                                    data-id="__react-email-column"
                                    style="padding-top:0px;padding-bottom:24px;padding-left:0px;padding-right:0px;text-align:left">
                                    <a
                                      href="https://example.com/docs"
                                      style="color:#067df7;text-decoration-line:none;font-family:Helvetica, Arial, sans-serif;font-size:14px;text-decoration:underline"
                                      target="_blank"
                                      >Read the docs</a
                                    >
                                  </td>
                                </tr>
                              </tbody>
                            </table>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </td>
                </tr>
              </tbody>
            </table>
          </td>
        </tr>
