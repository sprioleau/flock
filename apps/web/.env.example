# Convex (written to .env.local automatically by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# AI provider (Phase 3+, Gemini via @ai-sdk/google)
GOOGLE_GENERATIVE_AI_API_KEY=

# Resend (Phase 8 sending)
RESEND_API_KEY=
# Default sender for test sends — the domain must be verified in Resend.
# Format: "Display Name <hello@yourdomain.com>" (or a bare address).
# Per-document from-address config (plan 8.1) overrides this at send time.
RESEND_FROM_EMAIL=
# Optional: reply-to for test sends; defaults to the from address when empty.
RESEND_REPLY_TO_EMAIL=

# Access gate (src/proxy.ts). Empty/unset = gate DISABLED — everything passes,
# so local dev and CI stay frictionless; prod opts in by setting this in Vercel.
# When set, entry pages (/, bare /studio) require this password once (~30-day
# cookie), while links carrying a valid ?doc=<id> pass without it (capability
# links). Server-side only; rotating it invalidates all outstanding cookies.
TANDEM_ACCESS_PASSWORD=
