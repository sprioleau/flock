# Convex (written to .env.local automatically by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# The Convex SITE domain (*.convex.site) — where Better Auth's HTTP routes are
# served. Derived from NEXT_PUBLIC_CONVEX_URL when unset, so it is optional.
NEXT_PUBLIC_CONVEX_SITE_URL=

# AI provider (Phase 3+, Gemini via @ai-sdk/google)
GOOGLE_GENERATIVE_AI_API_KEY=

# Resend (Phase 8 sending)
RESEND_API_KEY=
# Default sender for test sends — the domain must be verified in Resend.
# Format: "Display Name <hello@yourdomain.com>" (or a bare address).
# Per-document from-address config (plan 8.1) overrides this at send time.
RESEND_FROM_EMAIL=
# Optional: reply-to for test sends; defaults to the from address when empty.
RESEND_REPLY_TO_EMAIL=

# ---------------------------------------------------------------------------
# Identity — Better Auth (anonymous → magic link)
# ---------------------------------------------------------------------------
# THE ROLL-OUT SWITCH. Unset/false = auth is completely inert: nobody is signed
# in, `/` sends visitors straight to the studio, and every session-scoped
# Convex function falls back to the localStorage session id exactly as it did
# before auth existed. Set to "true" to turn identity on.
NEXT_PUBLIC_FLOCK_AUTH_ENABLED=
#
# REMOVED: FLOCK_ACCESS_PASSWORD. The shared-password access gate is retired —
# see the decision note in src/app/page.tsx. It can be deleted from Vercel.
#
# The variables below are read by CONVEX functions, not by Next.js, so they are
# set on the deployment (`npx convex env set NAME value`), NOT in .env.local.
# Listed here because this file is where someone looks for "what does this app
# need configured".
#
#   BETTER_AUTH_SECRET              32+ random chars: openssl rand -base64 32
#   SITE_URL                        public origin, e.g. https://flockto.email
#   BETTER_AUTH_TRUSTED_ORIGINS     optional, comma-separated extra origins
#                                   (Vercel preview URLs)
#   RESEND_API_KEY                  magic-link delivery (same key as below)
#   RESEND_FROM_EMAIL               magic-link sender (same value as below)
#
#   FLOCK_REQUIRE_AUTH_IDENTITY     "true" closes the ownership hole for good:
#                                   client-supplied session ids stop being
#                                   accepted as owner keys. Flip only AFTER
#                                   NEXT_PUBLIC_FLOCK_AUTH_ENABLED is live.
#
#   FLOCK_CREDITS_PER_PERIOD                  claimed accounts   (default 25)
#   FLOCK_ANONYMOUS_CREDITS_PER_PERIOD        anonymous sessions (default 5)
#   FLOCK_ANONYMOUS_ORIGIN_CREDITS_PER_PERIOD shared per-network (default 20)
#   FLOCK_CREDIT_PERIOD_HOURS                 window length      (default 24)
#
# Sizing note: the Gemini free tier is ~20 requests/DAY for the whole
# deployment, not per user. Set these well below it on a free key.

# Owner override for the AI credit cap (src/lib/auth/owner-override.ts).
# Deliberately NOT the old access password: that one meant "may you use Flock",
# this one means "may you spend the API key without a limit". Empty/unset =
# no override exists on this deployment. Redeem it at POST /api/auth/override.
FLOCK_OWNER_OVERRIDE_PASSWORD=
